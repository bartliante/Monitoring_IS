<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
>
  <Dialog id="newConnectionDialog" title="{i18n>newConnectionTitle}" contentWidth="28rem">
    <content>
      <l:VerticalLayout class="sapUiSmallMargin" width="100%">
        <Label text="{i18n>connName}" labelFor="connName"/>
        <Input id="connName" width="100%"/>

        <Label text="{i18n>connApiUrl}" labelFor="connApiUrl" class="sapUiTinyMarginTop"/>
        <Input id="connApiUrl" width="100%" placeholder="https://tenant.it-cpi017.cfapps.eu10-002.hana.ondemand.com"/>

        <Label text="{i18n>connTokenUrl}" labelFor="connTokenUrl" class="sapUiTinyMarginTop"/>
        <Input id="connTokenUrl" width="100%" placeholder="https://tenant.authentication.eu10.hana.ondemand.com/oauth/token"/>

        <Label text="{i18n>connClientId}" labelFor="connClientId" class="sapUiTinyMarginTop"/>
        <Input id="connClientId" width="100%"/>

        <Label text="{i18n>connClientSecret}" labelFor="connClientSecret" class="sapUiTinyMarginTop"/>
        <Input id="connClientSecret" type="Password" width="100%"/>
      </l:VerticalLayout>
    </content>
    <beginButton>
      <Button text="{i18n>create}" type="Emphasized" press=".onCreateConnectionConfirm"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCreateConnectionCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>

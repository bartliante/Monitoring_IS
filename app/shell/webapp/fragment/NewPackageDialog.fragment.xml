<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
>
  <Dialog id="newPackageDialog" title="{i18n>newPackageTitle}" contentWidth="34rem">
    <content>
      <f:SimpleForm layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4">
        <Label text="{i18n>packageNameLabel}" labelFor="packageName"/>
        <Input id="packageName" width="100%" liveChange=".onPackageNameLiveChange"/>

        <Label text="{i18n>packageTechnicalNameLabel}" labelFor="packageTechnicalName"/>
        <Input id="packageTechnicalName" width="100%"/>

        <Label text="{i18n>packageShortTextLabel}" labelFor="packageShortText"/>
        <TextArea id="packageShortText" width="100%" rows="3"/>
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button text="{i18n>create}" type="Emphasized" press=".onCreatePackageConfirm"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCreatePackageCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>

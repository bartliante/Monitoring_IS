<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:macros="sap.fe.macros"
  xmlns:uxap="sap.uxap"
  controllerName="monitoringis.monitor.ext.controller.MessageProcessingLogDetail"
  displayBlock="true"
  height="100%"
>
  <uxap:ObjectPageLayout id="opLayout" height="100%">
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:heading>
          <Title text="{MessageGuid}" wrapping="true"/>
        </uxap:heading>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>
    <uxap:sections>

      <uxap:ObjectPageSection title="{i18n>sectionGeneralInfo}">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <macros:Form metaPath="@com.sap.vocabularies.UI.v1.FieldGroup#GeneralInformation"/>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="{i18n>sectionErrorDetail}" visible="{= %{Status} === 'FAILED' }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <TextArea
              id="errorTraceArea"
              value="{errorTrace>/text}"
              editable="false"
              growing="true"
              growingMaxLines="25"
              width="100%"
            />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="{i18n>sectionAttachments}">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <Text text="{i18n>noAttachments}" visible="{= !(${attachments>/}.length > 0) }" class="sapUiSmallMargin"/>
            <IconTabBar id="attachmentsTabBar" items="{attachments>/}" visible="{= ${attachments>/}.length > 0 }">
              <items>
                <IconTabFilter text="{attachments>Name}" key="{attachments>Id}">
                  <TextArea
                    value="{attachments>Content}"
                    editable="false"
                    growing="true"
                    growingMaxLines="25"
                    width="100%"
                  />
                </IconTabFilter>
              </items>
            </IconTabBar>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="{i18n>sectionAiSuggestion}" visible="{= %{Status} === 'FAILED' }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <VBox>
              <Button
                id="analyzeButton"
                text="{i18n>analyzeWithAI}"
                type="Emphasized"
                press=".onAnalyzeWithAI"
                enabled="{= !${aiSuggestion>/busy} }"
                class="sapUiSmallMarginBottom"
              />
              <Text text="{i18n>analyzing}" visible="{aiSuggestion>/busy}" class="sapUiSmallMarginBottom"/>
              <MessageStrip
                text="{aiSuggestion>/diagnosis}"
                visible="{= !!%{aiSuggestion>/diagnosis} }"
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom"
              />
              <HBox visible="{= !!%{aiSuggestion>/filePath} }" class="sapUiSmallMarginBottom">
                <VBox width="50%" class="sapUiTinyMarginEnd">
                  <Label text="{i18n>currentCodeLabel}"/>
                  <TextArea
                    value="{aiSuggestion>/currentCode}"
                    editable="false"
                    growing="true"
                    growingMaxLines="25"
                    width="100%"
                  />
                </VBox>
                <VBox width="50%" class="sapUiTinyMarginStart">
                  <Label text="{i18n>proposedCodeLabel}"/>
                  <TextArea
                    id="proposedCodeArea"
                    value="{aiSuggestion>/proposedCode}"
                    editable="true"
                    growing="true"
                    growingMaxLines="25"
                    width="100%"
                  />
                </VBox>
              </HBox>
              <Text text="{aiSuggestion>/explanation}" visible="{= !!%{aiSuggestion>/explanation} }" class="sapUiSmallMarginBottom"/>
              <Button
                text="{i18n>applyFixAndDeploy}"
                type="Emphasized"
                press=".onApplyFix"
                enabled="{= !!%{aiSuggestion>/filePath} &amp;&amp; !%{aiSuggestion>/busy} }"
              />
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

    </uxap:sections>
  </uxap:ObjectPageLayout>
</mvc:View>

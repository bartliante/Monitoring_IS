{
  "_version": "1.65.0",
  "sap.app": {
    "id": "monitoringis.monitor",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/monitor/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://alert",
      "favIcon": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "sap.fe.core.rootView.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.uxap": {},
        "sap.fe.core": {},
        "sap.fe.templates": {},
        "sap.fe.macros": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "monitoringis.monitor.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded"
        }
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MessageProcessingLogsList",
          "target": ["MessageProcessingLogsList"]
        },
        {
          "pattern": "MessageProcessingLogs({key}):?query:",
          "name": "MessageProcessingLogsDetail",
          "target": ["MessageProcessingLogsList", "MessageProcessingLogsDetail"]
        }
      ],
      "targets": {
        "MessageProcessingLogsList": {
          "type": "Component",
          "id": "MessageProcessingLogsList",
          "name": "sap.fe.core.fpm",
          "controlAggregation": "beginColumnPages",
          "contextPattern": "",
          "options": {
            "settings": {
              "contextPath": "/MessageProcessingLogs",
              "viewName": "monitoringis.monitor.ext.view.ListReportCustom",
              "navigation": {
                "MessageProcessingLogs": {
                  "detail": {
                    "route": "MessageProcessingLogsDetail"
                  }
                }
              }
            }
          }
        },
        "MessageProcessingLogsDetail": {
          "type": "Component",
          "id": "MessageProcessingLogsDetail",
          "name": "sap.fe.core.fpm",
          "controlAggregation": "midColumnPages",
          "contextPattern": "/MessageProcessingLogs({key})",
          "options": {
            "settings": {
              "contextPath": "/MessageProcessingLogs",
              "viewName": "monitoringis.monitor.ext.view.MessageProcessingLogDetail"
            }
          }
        }
      }
    }
  }
}
